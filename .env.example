# Copy to .env — defaults work out of the box
REQUEST_TIMEOUT_SECONDS=30
PAST_DAYS=1

# Postgres connection.
# The bundled docker-compose.yml publishes Postgres on host port 5433
# (to avoid colliding with any other local Postgres on 5432), so set
# DB_PORT=5433 when using it. Point these at any other database as needed.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=weather_db
DB_USER=etl_user
DB_PASSWORD=change_me
